# Copy to .env and fill in real values. Never commit .env with real secrets.

# --- Supabase --------------------------------------------------------------
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# --- Adzuna job data (required for live job listings) -----------------------
# https://developer.adzuna.com/ -- register an app to get these two values.
# Read server-side only (src/lib/jobs/adzuna-adapter.server.ts). Never
# exposed to the browser.
ADZUNA_APP_ID="your-adzuna-app-id"
ADZUNA_APP_KEY="your-adzuna-app-key"
# Optional alias for ADZUNA_APP_KEY, accepted for convenience if you (or a
# platform's env-var UI) end up naming it "API key" instead of "app key" --
# only one of ADZUNA_APP_KEY / ADZUNA_API_KEY is required.
# ADZUNA_API_KEY="your-adzuna-app-key"

# --- Automatic Adzuna sync (Phase 3.5) --------------------------------------
# "daily" (default) or "hourly". Read at BUILD time to select the Cloudflare
# Cron Trigger expression baked into the deployed Worker -- changing this
# requires a rebuild + redeploy, not just an env var flip on a running
# deployment. See vite.config.ts.
ADZUNA_SYNC_SCHEDULE="daily"
# Optional: narrow what the automatic sync searches for. Leaving these unset
# uses the adapter's own defaults (broad search, country "in" -- Rolisha
# is an India-first product). Manual syncs from /admin/jobs can still
# specify their own query/location/country/limit per click regardless of
# these.
# ADZUNA_SYNC_QUERY=""
# ADZUNA_SYNC_LOCATION=""
# ADZUNA_SYNC_COUNTRY="in"
# ADZUNA_SYNC_MAX_JOBS="50"

# Secret for the HTTP cron fallback (POST /api/cron/adzuna-sync) — only
# needed if you're triggering sync via an external scheduler instead of (or
# in addition to) the native Cloudflare Cron Trigger. Not required for the
# native scheduled path, which has no public HTTP endpoint at all.
# CRON_SECRET="a-long-random-string"
# CRON_SECRET_PREVIOUS="previous-secret-during-rotation"

# --- AI features (Phase 3) --------------------------------------------------
# Read server-side only (src/lib/ai/provider.server.ts). Never exposed to
# the browser -- there is no VITE_GROQ_API_KEY.
# GROQ_API_KEY="gsk_..."
# AI_PROVIDER="groq"
# AI_MODEL="openai/gpt-oss-120b"
# AI_TIMEOUT_MS="45000"
#
# Anthropic is still supported by the same provider abstraction as a
# fallback -- set AI_PROVIDER="anthropic" and ANTHROPIC_API_KEY instead if
# you need it for a specific environment.
# ANTHROPIC_API_KEY="sk-ant-..."

# --- Payments (Phase 4, Razorpay) -------------------------------------------
# RAZORPAY_KEY_ID="rzp_live_..."
# RAZORPAY_KEY_SECRET="..."
# RAZORPAY_WEBHOOK_SECRET="..."
# RAZORPAY_PLAN_ID_PRO="plan_..."
# RAZORPAY_SUBSCRIPTION_TOTAL_COUNT="120"
